# .env.example — copy to .env and fill in real values (never commit .env)

# ── Portfolio settings ──────────────────────────────────────────────────────
# Base currency for all portfolio values (SGD recommended for SG residents)
# See INVESTMENT_PLAN.md §6.5
BASE_CURRENCY=SGD

# ── Telegram bot (optional — enables daily push notifications) ───────────────
# 1. Create a bot via @BotFather on Telegram, copy the token here
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id in the JSON response
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── API keys ─────────────────────────────────────────────────────────────────
# Polygon.io — optional, enables Polygon price backend (free tier: 5 req/min)
POLYGON_API_KEY=your_polygon_api_key_here

# FRED — optional, enables FRED JSON API (higher rate limits than CSV endpoint)
# Free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── File paths ────────────────────────────────────────────────────────────────
OUTPUT_DIR=output

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
