# .gitignore
# Environment
.env
venv/
env/
*.pyc
__pycache__/

# Output files (reports are local — regenerated on each run)
output/*.csv
output/*.png
output/*.md
!output/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# Data (working files — local only)
data/*.csv
data/*.json
data/*.txt
data/cache/
data/upside/
data/archive/
!data/.gitkeep

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Personal drafts / notes (keep local)
BLOG.md
BLOG2.md
